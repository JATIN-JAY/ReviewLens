# Hosted setup. Gemini free tier has limited quotas and may use content to improve Google products.
AI_PROVIDER=gemini
GEMINI_API_KEY=add_your_google_ai_studio_key
GEMINI_MODEL=gemini-3-flash-preview

# Required in production. Use a long, unique password for private access.
APP_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Most hosts set PORT automatically. HOST defaults to 0.0.0.0 in production.
